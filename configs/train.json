{
  "integration": "ecb.integrations.minionerec:build",
  "integration_options": {
    "minionerec_root": "../MiniOneRec",
    "base_checkpoint": "checkpoints/minionerec",
    "ranker_checkpoint": "checkpoints/ranker",
    "catalog": "data/catalog.jsonl",
    "train_contexts": "data/train_contexts.jsonl",
    "train_targets": "data/train_targets.jsonl",
    "eval_contexts": "data/eval_contexts.jsonl",
    "eval_targets": "data/eval_targets.jsonl",
    "transitions": "data/train_transitions.json",
    "device": "cuda:0",
    "max_prompt_tokens": 2048,
    "score_batch_size": 2,
    "signal_items": 3,
    "ranker_cost": 0.001,
    "retrieval_cost": 0.001,
    "reward_rollouts": 2
  },
  "model": {
    "embedding_dim": 128,
    "hidden_dim": 64,
    "max_rounds": 3,
    "history_size": 32,
    "shortlist_size": 20,
    "pool_size": 100,
    "retrieval_slots": 6,
    "budget": 100.0,
    "seed": 42,
    "epochs": 10,
    "warmup_epochs": 1,
    "batch_size": 8,
    "gate_passes": 5,
    "learning_rate": 0.001,
    "entropy_weight": 0.001,
    "gradient_clip": 5.0,
    "gate_threshold": 0.0
  },
  "reward_fit": {
    "epochs": 20,
    "learning_rate": 0.001
  },
  "reward_checkpoint": "outputs/reward/reward.pt",
  "output_dir": "outputs/controller"
}
